# Copy to backend/.env and fill in. Never commit .env.

# AWS region where the Aurora cluster lives
AWS_REGION=us-east-1

# Aurora PostgreSQL connection (IAM database auth, no password stored). Required when DATA_BACKEND=postgres.
# A fresh IAM token is generated from your AWS credentials on every connect; DB_PASSWORD is not used.
DB_HOST=your-cluster-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=LPLTeam20
DB_USER=postgres
# Bedrock model or inference profile ID (Claude). Must be invocable in AWS_REGION.
BEDROCK_MODEL_ID=us.anthropic.your-claude-model-id
# Data backend: postgres is the only option (read-only snapshot of DB_NAME, loaded once at startup;
# restart the server to refresh). There is no seed or sample data.
DATA_BACKEND=postgres
# Optional: client shown by default in the web UI (default 1)
# DEMO_CLIENT_ID=1
# Tests only (shell, not .env): RUN_POSTGRES_TESTS=1 enables the live test in tests/test_postgres_loader.py
# Audit log backend: memory (in-memory) or s3
AUDIT_BACKEND=memory
